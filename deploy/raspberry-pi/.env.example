# Compose image identity. Set this to the deployed Git tag or commit SHA.
RUSKI_IMAGE_TAG=local

# Bind to 127.0.0.1 normally. Use the Pi's private Ethernet address only for
# the documented LAN acceptance test.
RUSKI_API_BIND_ADDRESS=127.0.0.1
RUSKI_API_PORT=3000

# Move this path to an SSD mount before live tournament production.
RUSKI_POSTGRES_DATA_PATH=/srv/ruski-report/postgres
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=ruski_report
POSTGRES_USER=ruski
# Use a URL-safe value such as: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-url-safe-secret

# Use a separate value such as: openssl rand -hex 48
ADMIN_API_TOKEN=replace-with-a-separate-random-secret
MODERATION_OPERATOR_ID=tournament-operator

DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
