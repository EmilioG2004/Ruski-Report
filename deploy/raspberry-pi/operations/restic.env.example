# This example contains placeholders only. Install the real file as
# /opt/ruski-report/secrets/restic.env with owner root:root and mode 0600.
RESTIC_REPOSITORY=s3:s3.us-east-1.amazonaws.com/ruski-report-backups-AWS_ACCOUNT_ID-us-east-1/restic
RESTIC_PASSWORD_FILE=/opt/ruski-report/secrets/restic-password
RESTIC_CACHE_DIR=/var/cache/ruski-report-restic
AWS_ACCESS_KEY_ID=replace-with-the-dedicated-pi-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-the-dedicated-pi-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# Non-secret deployment paths used by the backup and restore scripts.
RUSKI_COMPOSE_DIR=/opt/ruski-report/source/deploy/raspberry-pi
RUSKI_COMPOSE_ENV_FILE=/opt/ruski-report/source/deploy/raspberry-pi/.env
RUSKI_CLOUDFLARED_ENV_FILE=/opt/ruski-report/secrets/cloudflared.env
RUSKI_SOURCE_WORKBOOK_DIR=/srv/ruski-report/source-workbooks
RUSKI_BACKUP_WORK_DIR=/var/lib/ruski-report-backup
