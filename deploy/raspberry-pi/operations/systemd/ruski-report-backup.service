[Unit]
Description=Create and retain an encrypted Ruski Report backup in Amazon S3
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/opt/ruski-report/secrets/restic.env
ExecStart=/usr/local/lib/ruski-report/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ruski-report-backup /var/cache/ruski-report-restic
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
