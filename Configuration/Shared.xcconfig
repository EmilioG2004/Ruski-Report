// Canonical v1 release identity. Keep environment endpoints in AppConfig.json.
RUSKI_APP_BUNDLE_IDENTIFIER = com.emiliogarcia.ruskireport
RUSKI_APP_DISPLAY_NAME = Ruski Report
RUSKI_BUILD_NUMBER = 1
RUSKI_DEVELOPMENT_TEAM = F4784JNT6Y
RUSKI_IOS_DEPLOYMENT_TARGET = 17.0
RUSKI_MARKETING_VERSION = 1.0

CODE_SIGN_STYLE = Automatic
CURRENT_PROJECT_VERSION = $(RUSKI_BUILD_NUMBER)
DEVELOPMENT_TEAM = $(RUSKI_DEVELOPMENT_TEAM)
IPHONEOS_DEPLOYMENT_TARGET = $(RUSKI_IOS_DEPLOYMENT_TARGET)
MARKETING_VERSION = $(RUSKI_MARKETING_VERSION)
SDKROOT = iphoneos

// Ruski Report v1 is intentionally an iPhone-only release.
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
TARGETED_DEVICE_FAMILY = 1
