DATABASE_URL=postgresql://ruski:replace-me@localhost:5432/ruski_report
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_MIGRATIONS_DIR=/absolute/path/to/migrations

PORT=3000
ADMIN_UPLOAD_TOKEN=replace-me

# Public account authentication defaults are shown below.
AUTH_MAX_DISPLAY_NAME_LENGTH=40
AUTH_MIN_PASSWORD_LENGTH=10
AUTH_MAX_PASSWORD_LENGTH=128
AUTH_SESSION_LIFETIME_SECONDS=2592000
AUTH_SCRYPT_COST=16384
AUTH_SCRYPT_BLOCK_SIZE=8
AUTH_SCRYPT_PARALLELIZATION=1
AUTH_SCRYPT_KEY_LENGTH=64
AUTH_SCRYPT_SALT_LENGTH=16
AUTH_SESSION_TOKEN_LENGTH=32

# Match comment moderation and spam-prevention settings.
COMMENT_MAX_BODY_LENGTH=500
COMMENT_DUPLICATE_WINDOW_SECONDS=300
COMMENT_MAX_LINKS=2
COMMENT_MAX_REPEATED_CHARACTER_RUN=8
COMMENT_MAX_REPEATED_TOKEN_COUNT=4
# COMMENT_MODERATION_RULES_PATH=/etc/ruski/comment-moderation-rules.json

# Integration tests use a disposable database and truncate application tables.
TEST_DATABASE_URL=postgresql://ruski:replace-me@localhost:5432/ruski_report_test
