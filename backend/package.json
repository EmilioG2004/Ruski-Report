{
  "name": "ruski-report-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend for Ruski Report tournament data ingestion and APIs.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "smoke:realtime": "node scripts/smoke-realtime.mjs",
    "db:backfill:legacy": "ts-node src/database/backfill-legacy.ts",
    "db:backfill:legacy:prod": "node dist/database/backfill-legacy.js",
    "db:migrate": "ts-node src/database/migrate.ts",
    "db:migrate:prod": "node dist/database/migrate.js",
    "test": "jest --runInBand",
    "test:postgres": "node -e \"if (!process.env.TEST_DATABASE_URL || !process.env.POPULATED_MIGRATION_DATABASE_URL) { console.error('TEST_DATABASE_URL and POPULATED_MIGRATION_DATABASE_URL are required'); process.exit(1); }\" && jest --runInBand --testPathPattern='(postgres-persistence|postgres-tournament-engine|postgres-legacy-backfill|tournament-engine-populated-migration)\\.integration\\.spec\\.ts$'",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/websockets": "^11.1.28",
    "exceljs": "^4.4.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
